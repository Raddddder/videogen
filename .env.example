# Backend runtime
VSME_ENV=local
VSME_API_HOST=127.0.0.1
VSME_API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# Provider routing. Use mock first, then switch providers one by one.
ASR_PROVIDER=mock
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SEC=60

# Recommended official competition structure classifier.
# LLM_PROVIDER=ark
# LLM_MODEL=ep-20260508213828-7ntjl
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ASR. Copy this file to .env and fill real keys locally only.
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=
ASR_TIMEOUT_SEC=180
ASR_AUDIO_MAX_BYTES=52428800
MAX_SAMPLE_UPLOAD_BYTES=52428800

# Module B material understanding vision model (optional).
# Defaults to reusing LLM_API_KEY / LLM_BASE_URL so one OpenAI-compatible
# provider (e.g. SiliconFlow) can power ASR fallback, LLM and the VLM.
MATERIAL_VLM_ENABLED=true
MATERIAL_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# MATERIAL_VLM_API_KEY=
# MATERIAL_VLM_BASE_URL=
MATERIAL_VLM_TIMEOUT_SEC=60

# AIGC 文生图(缺口补全)。默认复用 MATERIAL_VLM 的 key/base(SiliconFlow)。
AIGC_IMAGE_ENABLED=true
AIGC_IMAGE_MODEL=Kwai-Kolors/Kolors
# AIGC_IMAGE_API_KEY=
# AIGC_IMAGE_BASE_URL=
AIGC_IMAGE_TIMEOUT_SEC=90

# ===== 推荐本地真实配置(口播视频效果最好) =====
# ASR 用 DashScope fun-asr-realtime(有句级时间戳，LLM 结构判断才真正生效):
#   ASR_PROVIDER=dashscope_realtime  ASR_MODEL=fun-asr-realtime  ASR_LANGUAGE_HINTS=zh
#   DASHSCOPE_API_KEY=<阿里云百炼 key>   (并清空 ASR_API_KEY 以走 DASHSCOPE_API_KEY)
# LLM 结构判断也用 DashScope(国内更快更稳)：LLM_PROVIDER=dashscope  LLM_MODEL=qwen-plus

# DashScope fun-asr. Requires a public URL for files; local 127.0.0.1 is not reachable by DashScope.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_PUBLIC_BASE_URL=
ASR_LANGUAGE_HINTS=zh,en
ASR_POLL_INTERVAL_SEC=1

# DashScope realtime ASR. This reads local extracted audio through SDK/WebSocket; no public file URL is required.
# ASR_PROVIDER=dashscope_realtime
# ASR_MODEL=fun-asr-realtime
# ASR_LANGUAGE_HINTS=zh
DASHSCOPE_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# SiliconFlow ASR fallback.
SILICONFLOW_ASR_BASE_URL=https://api.siliconflow.cn/v1/audio/transcriptions
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# Model provider keys. Keep real keys outside git.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=ep-20260508213828-7ntjl

# Optional fallback providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Rendering
PREVIEW_RENDERER=remotion
CAPCUT_DRAFT_ENABLED=false
