{
  "name": "videogen",
  "version": "1.0.0",
  "description": "Viral short-video structure migration engine with FastAPI, React, and Remotion preview rendering.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raddddder/videogen.git"
  },
  "license": "MIT",
  "dependencies": {
    "@remotion/cli": "4.0.463",
    "@remotion/media": "4.0.463",
    "@remotion/tailwind-v4": "4.0.463",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.463",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.463",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render MarketingRibbonVideo public/poster-demo.mp4 --codec=h264",
    "still": "remotion still MarketingRibbonVideo --frame=120 public/preview.png",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "backend:dev": "cd backend && uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "frontend:dev": "npm --prefix frontend run dev",
    "validate": "python3 scripts/validate_contracts.py",
    "demo:pipeline": "python3 scripts/run_demo_pipeline.py",
    "render:structure": "remotion render StructurePreview public/structure-preview.mp4 --codec=h264",
    "still:structure": "remotion still StructurePreview --frame=90 public/structure-preview.png"
  },
  "keywords": [
    "ai-video",
    "fastapi",
    "generative-design",
    "motion-graphics",
    "react",
    "remotion",
    "short-video",
    "structure-migration",
    "typography",
    "video"
  ],
  "author": "Raddddder",
  "bugs": {
    "url": "https://github.com/Raddddder/videogen/issues"
  },
  "homepage": "https://github.com/Raddddder/videogen#readme",
  "sideEffects": [
    "*.css"
  ]
}
