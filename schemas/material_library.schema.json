{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/material_library.schema.json",
  "title": "MaterialLibrary",
  "type": "object",
  "required": ["schema_version", "project_id", "materials"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "project_id": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "category": {"type": "string"},
        "selling_points": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "material_id",
          "type",
          "file_name",
          "duration_sec",
          "aspect_ratio",
          "usable_ranges",
          "shot_type",
          "semantic_role",
          "tags",
          "emotion_score",
          "quality_score",
          "crop_risk"
        ],
        "properties": {
          "material_id": {"type": "string"},
          "type": {"type": "string", "enum": ["video_clip", "image", "copy", "audio"]},
          "file_name": {"type": "string"},
          "duration_sec": {"type": "number", "minimum": 0},
          "aspect_ratio": {"type": "string"},
          "usable_ranges": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "shot_type": {"type": "string"},
          "semantic_role": {
            "type": "string",
            "enum": ["hook", "pain_point", "setup", "solution", "proof", "transition", "cta", "unknown"]
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          },
          "emotion_score": {"type": "number", "minimum": 0, "maximum": 10},
          "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
          "crop_risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "transcript": {"type": "string"},
          "key_visuals": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
