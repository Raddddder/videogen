{
  "schema_version": "1.0",
  "project": {
    "default_project_id": "case_001",
    "default_variant": "balanced",
    "supported_categories": [
      "product_talk",
      "knowledge_talk",
      "mixed_talk"
    ]
  },
  "pipeline": {
    "segment_functions": [
      "hook",
      "pain_point",
      "setup",
      "solution",
      "proof",
      "transition",
      "cta"
    ],
    "slot_statuses": [
      "matched",
      "weak_match",
      "missing",
      "supplemented"
    ],
    "completion_strategies": [
      "direct_match",
      "reorder",
      "copy",
      "packaging",
      "aigc",
      "reuse"
    ],
    "scoring_weights": {
      "shot_type_match": 0.3,
      "semantic_role_match": 0.3,
      "emotion_match": 0.15,
      "duration_match": 0.15,
      "quality_score": 0.1
    }
  },
  "mock_files": {
    "structure_dna": "mocks/structure_dna.sample.json",
